// Diagrama de estados del AFD que reconoce <iniciales><número>@uni.edu.ni
// Generar con: dot -Tpng docs/diagrama-afd.dot -o docs/diagrama-afd.png
digraph AFD {
  graph [rankdir=LR, nodesep=0.30, ranksep=0.45, fontname="Helvetica", fontsize=11,
         labelloc="t", label="AFD — correo institucional UNI:  <iniciales 2–4 a-z><2–3 dígitos>@uni.edu.ni\nQ = {q0…q19},  Σ = {a–z, 0–9, @, .}  (38 símbolos),  F = {q18}"];
  node  [shape=circle, style=filled, fillcolor="#EAF2FB", color="#2F5597", fontname="Helvetica", fontsize=10, width=0.42, fixedsize=true];
  edge  [fontname="Helvetica", fontsize=9, color="#2F5597", arrowsize=0.7];

  // ---------------- parte local: iniciales y número ----------------
  start [shape=point, width=0.06, fillcolor=black];
  q0  [label="q0"];  q1 [label="q1"];  q2 [label="q2"];  q3 [label="q3"];  q4 [label="q4"];
  q5  [label="q5"];  q6 [label="q6"];  q7 [label="q7"];

  start -> q0;
  q0 -> q1 [label="a–z"];
  q1 -> q2 [label="a–z"];
  q2 -> q3 [label="a–z"];  q2 -> q5 [label="0–9"];
  q3 -> q4 [label="a–z"];  q3 -> q5 [label="0–9"];
  q4 -> q5 [label="0–9"];
  q5 -> q6 [label="0–9"];
  q6 -> q7 [label="0–9"];  q6 -> q8 [label="@"];
  q7 -> q8 [label="@"];

  // ---------------- parte del dominio: @uni.edu.ni ----------------
  q8  [label="q8"];  q9  [label="q9"];  q10 [label="q10"]; q11 [label="q11"];
  q12 [label="q12"]; q13 [label="q13"]; q14 [label="q14"]; q15 [label="q15"];
  q16 [label="q16"]; q17 [label="q17"];
  q18 [label="q18", shape=doublecircle, fillcolor="#D9EAD3", color="#1B8A3A"];
  q19 [label="q19", style="dashed,filled", fillcolor="#FCE4E4", color="#C62828"];

  q8  -> q9  [label="u"];
  q9  -> q10 [label="n"];
  q10 -> q11 [label="i"];
  q11 -> q12 [label="."];
  q12 -> q13 [label="e"];
  q13 -> q14 [label="d"];
  q14 -> q15 [label="u"];
  q15 -> q16 [label="."];
  q16 -> q17 [label="n"];
  q17 -> q18 [label="i"];

  // ---------------- estados absorbentes ----------------
  q18 -> q19 [label="Σ", color="#C62828", style=dashed];
  q19 -> q19 [label="Σ", color="#C62828", style=dashed];

  // Toda transición no dibujada conduce a q19 (la función δ es total).
  leyenda [shape=note, style=filled, fillcolor="#FFF8E1", color="#B8860B",
           fontname="Helvetica", fontsize=9, width=3.6, fixedsize=false,
           label="Transiciones no dibujadas → q19\l(el símbolo no encaja con ninguna salida del estado)\lEjemplo: q4 no admite letras, q7 no admite dígitos, q11 solo admite el punto\lVerde: q18 es el único estado final.   Rojo: q19 es el sumidero de rechazo.\l"];
  q17 -> leyenda [style=invis];
}
